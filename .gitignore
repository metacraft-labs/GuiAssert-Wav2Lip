# Python venv + cloned Wav2Lip upstream (rehydrated by scripts/install.sh).
/.venv/
/python/upstream/

# Model weights — installed under upstream/checkpoints/ and the face
# detector directory.
*.safetensors
*.pth
*.ckpt
*.onnx
*.tar
*.zip

# Nim build artefacts.
nimcache/
# Per-checkout nimcache (config.nims): every Nim compile in this checkout
# keeps its intermediate files here, never in the shared ~/.cache/nim.
.nimcache/
nimblecache/
*.exe
*.dSYM
tests/twav2lip

# Editor / OS noise.
.DS_Store
*.swp
*.bak

# Nix results.
/result
/result-*

# Auto-generated by git-hooks.nix in the workspace's nix devShell.
/.pre-commit-config.yaml

# Repro development environment cache
.repro/
